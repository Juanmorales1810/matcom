                    href="https://x.com/matcom"
                    rel="noreferrer"
                    target="_blank"
                    class="text-gray-700 transition hover:text-gray-700/75 dark:text-white dark:hover:text-white/75">
                    <span class="sr-only">X</span>
                    <svg class="size-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path
                            d="M18.244 2H21.5l-7.11 8.13L22.75 22h-6.54l-5.13-6.68L5.4 22H2.14l7.6-8.69L1.75 2h6.69l4.64 6.11L18.244 2zm-1.15 18h1.8L6.78 4H4.85l12.244 16z"
