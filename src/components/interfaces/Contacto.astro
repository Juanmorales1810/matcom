---
import { GlobeIcon, MailIcon, PhoneIcon } from 'lucide-react';
import { Contact } from '@/components/form';

const socialLinks = [
    {
        label: 'Facebook',
        url: 'https://www.facebook.com',
        path: 'M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z',
    },
    {
        label: 'X',
        url: 'https://x.com',
        path: 'M18.244 2H21.5l-7.11 8.13L22.75 22h-6.54l-5.13-6.68L5.4 22H2.14l7.6-8.69L1.75 2h6.69l4.64 6.11L18.244 2zm-1.15 18h1.8L6.78 4H4.85l12.244 16z',
    },
    {
        label: 'LinkedIn',
        url: 'https://www.linkedin.com',
        path: 'M19 3A2 2 0 0 1 21 5v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2zm-8.339 6H7.98V17h2.681zM9.32 7.872A1.56 1.56 0 1 0 9.32 4.75a1.56 1.56 0 0 0 0 3.122M17 17v-4.399c0-2.356-1.256-3.451-2.932-3.451-1.35 0-1.954.742-2.292 1.264V9H9.098c.036.874 0 8 0 8h2.678v-4.469c0-.239.017-.478.088-.649.194-.478.636-.973 1.377-.973.971 0 1.359.742 1.359 1.832V17z',
    },
];
---

<section class="bg-muted py-32">
    <div class="container mx-auto px-4">
        <div class="mx-auto max-w-5xl">
            <div class="flex flex-col gap-4 text-left">
                <h1
                    class="text-3xl font-semibold tracking-tight text-pretty sm:text-4xl lg:text-5xl">
                    Contact Us
                </h1>
                <p class="text-muted-foreground lg:text-xl lg:text-balance">
                    Building with shadcn/ui and Tailwind? Ask us about blocks, components, or
                    copy-paste sections-we read every message.
                </p>
            </div>

            <div
                class="md:divide-border mt-10 flex gap-10 max-md:flex-col md:mt-16 md:gap-0 md:divide-x">
                <div class="space-y-10 md:pr-10">
                    <div>
                        <h2 class="text-lg font-semibold tracking-tight text-balance">
                            Corporate office
                        </h2>
                        <p class="text-muted-foreground mt-3 font-medium tracking-tight">
                            1200 Framework Boulevard
                            <br />
                            San Francisco, CA 94102, United States
                        </p>
                    </div>

                    <div>
                        <h2 class="text-lg font-semibold tracking-tight text-balance">
                            Get in touch
                        </h2>
                        <div class="mt-3 flex flex-col gap-6">
                            <a
                                href={`tel:+15550102400`}
                                class="group text-muted-foreground hover:text-foreground flex items-center gap-3 font-medium tracking-tight">
                                <PhoneIcon className="text-muted-foreground size-5 shrink-0" />
                                <span class="group-hover:underline">+1 (555) 010-2400</span>
                            </a>
                            <a
                                href={`mailto:hello@shadcnblocks.com`}
                                class="group text-muted-foreground hover:text-foreground flex items-center gap-3 font-medium tracking-tight">
                                <MailIcon className="text-muted-foreground size-5 shrink-0" />
                                <span class="group-hover:underline">hello@shadcnblocks.com</span>
                            </a>
                            <a
                                href="https://shadcnblocks.com"
                                target="_blank"
                                rel="noreferrer"
                                aria-label={`shadcnblocks.com (opens in new tab)`}
                                class="group text-muted-foreground hover:text-foreground flex items-center gap-3 font-medium tracking-tight">
                                <GlobeIcon className="text-muted-foreground size-5 shrink-0" />
                                <span class="group-hover:underline">shadcnblocks.com</span>
                            </a>
                        </div>
                    </div>

                    <div>
                        <h2 class="text-lg font-semibold tracking-tight text-balance">Follow us</h2>
                        <div class="mt-3 flex gap-6">
                            {
                                socialLinks.map((link) => {
                                    return (
                                        <a
                                            href={link.url}
                                            target="_blank"
                                            rel="noreferrer"
                                            aria-label={`${link.label} (opens in new tab)`}
                                            class="text-muted-foreground hover:text-foreground">
                                            <svg
                                                class="size-6"
                                                viewBox="0 0 24 24"
                                                fill="currentColor"
                                                aria-hidden="true">
                                                <path d={link.path} />
                                            </svg>
                                        </a>
                                    );
                                })
                            }
                        </div>
                    </div>
                </div>

                <div class="flex-1 md:pl-10">
                    <Contact client:load />
                </div>
            </div>
        </div>
    </div>
</section>
