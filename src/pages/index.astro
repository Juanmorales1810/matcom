---
import Layout from '@/layouts/Layout.astro';
import Hero from '@/components/interfaces/Hero.astro';
import { Feature } from '@/components/interfaces/Feature';
import Services from '@/components/interfaces/Services.astro';
import WhyUs from '@/components/interfaces/WhyUs.astro';
import Diferenciadores from '@/components/interfaces/Diferenciadores.astro';
import { Timeline } from '@/components/interfaces/Timeline';
import { Gallery } from '@/components/interfaces/Gallery';
import { Testimonial } from '@/components/interfaces/Testimonial';
import { Faq } from '@/components/interfaces/Faq';
import Contacto from '@/components/interfaces/Contacto.astro';
---

<Layout
    title="Matcon | Empresa constructora"
    description="Matcon es una empresa constructora dedicada a ofrecer servicios de construcción de alta calidad. Con años de experiencia en el sector, nos especializamos en proyectos residenciales, comerciales e industriales. Nuestro compromiso es brindar soluciones innovadoras y sostenibles para satisfacer las necesidades de nuestros clientes."
    canonical="https://matcom.cl/"
    image="https://matcom.cl/og-image.jpg">
    <Hero />
    <Feature client:idle />
    <Services />
    <WhyUs />
    <Diferenciadores />
    <Timeline client:idle />
    <Gallery client:idle />
    <Testimonial client:idle />
    <Faq client:idle />
    <Contacto />
</Layout>
